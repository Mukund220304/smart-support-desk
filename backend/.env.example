# Environment variables — copy this file to .env and fill in your values

# MongoDB connection string
# Local:  mongodb://localhost:27017/smart-support-desk
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-support-desk
MONGODB_URI=mongodb://localhost:27017/smart-support-desk

# Port the Express server listens on
PORT=3001

# URL of the Python ML prediction service
ML_SERVICE_URL=http://localhost:5001

# Set to 'development' locally, 'production' in prod
NODE_ENV=development
